      ],
      "webhookId": "f42c50c0-7e8c-4708-a437-70912fa2294b",
      "credentials": {
        "discordWebhookApi": {
          "id": "RCupNHwYFx6qkUsA",
          "name": "Discord Webhook account"
        }
      }
    }
