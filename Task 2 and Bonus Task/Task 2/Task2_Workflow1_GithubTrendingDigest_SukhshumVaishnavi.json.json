      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -32,
        48
      ],
      "webhookId": "morning-brief-trigger"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/repositories",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=topic:machine-learning created:>{{$now.minus({days:7}).toFormat('yyyy-MM-dd')}}"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "4d696cfd-1ee2-487d-ac92-02387692ada2",
      "name": "HTTP1: Fetch GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        -48
      ],
      "continueOnFail": true,
      "notes": "authentication is set to 'none' so this works unauthenticated against GitHub's public rate limit (60 req/hr/IP). To raise the limit, switch 'authentication' to 'genericCredentialType' / 'httpHeaderAuth' and attach a Personal Access Token credential named 'GitHub Token Header Auth' with header 'Authorization: Bearer <token>'. Do this on BOTH HTTP1 and HTTP2 consistently — don't authenticate one and not the other."
    },
    {
      "parameters": {
        "jsCode": "// Guard: if the upstream call failed, forward a single error-marker item.\nif ($input.first().json.error) {\n  return [{ json: { error: $input.first().json.error, stage: 'fetch_repos' } }];\n}\n\nconst items = $input.first().json.items || [];\n\nconst top5 = items\n  .map(r => ({\n    name: r.full_name,\n    owner: r.owner.login,\n    repo: r.name,\n    stars: r.stargazers_count,\n    url: r.html_url,\n    description: r.description || 'No description provided.'\n  }))\n  .sort((a, b) => b.stars - a.stars)\n  .slice(0, 5);\n\n// Explicitly handle zero matching repos instead of letting the run go quiet.\nif (top5.length === 0) {\n  return [{ json: { error: 'No repositories matched the search query.', stage: 'transform_empty' } }];\n}\n\nreturn top5.map(item => ({ json: item }));"
      },
      "id": "f2992068-734e-447c-806a-167601b125f3",
      "name": "Transform: Top 5 by Stars",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all().map(i => i.json);\nif (!all.length || all[0].error) {\n  return [{ json: { error: all[0]?.error || 'no_items', stage: all[0]?.stage || 'select_top' } }];\n}\nconst top = all[0];\nreturn [{ json: { ...top, _allTop5: all } }];"
      },
      "id": "4a93f35f-d166-45d3-8f36-29d348bc34f9",
      "name": "Select Top Repo for Enrichment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{$json.owner}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "437f6634-32af-4b86-a54d-d4c09ad5ed5a",
      "name": "IF: Valid Repo Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        528,
        160
      ],
      "notes": "Fix for Issue 3: HTTP2 must never run on an error/empty-results item, since it would build a malformed URL from a missing owner/repo. This checks that 'owner' actually exists before allowing enrichment."
    },
    {
      "parameters": {
        "authentication": "webhook",
        "options": {}
      },
      "id": "d5c4eb9c-299e-4266-93d2-f515f7da69da",
