    {
      "parameters": {
        "jsCode": "// Fix for Issue 1: pull the ORIGINAL repo metadata back by node reference —\n// this item never depended on HTTP2 succeeding, so it survives either branch.\nconst repo = $('Select Top Repo for Enrichment').item.json;\n\nreturn [{\n  json: {\n    ...repo,\n    readmeSnippet: '⚠️ README could not be fetched for this repo (error logged, digest still sent).',\n    fetchOk: false\n  }\n}];"
      },
      "id": "4e57e2b6-beb5-40f2-8e19-98902886ff27",
      "name": "Code: Build Enriched Item (Fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fix for Issue 1 (success path): same node-reference approach, so this branch\n// and the fallback branch above both emit the IDENTICAL shape with no Merge node needed —\n// this is the fix for Issue 2 (mutually exclusive branches feeding one Merge could stall).\nconst repo = $('Select Top Repo for Enrichment').item.json;\n\nconst raw = typeof $json === 'string' ? $json : ($json.data || $json.body || JSON.stringify($json));\nconst text = String(raw).replace(/\\n+/g, ' ').trim();\n\nreturn [{\n  json: {\n    ...repo,\n    readmeSnippet: text.slice(0, 300) + (text.length > 300 ? '…' : ''),\n    fetchOk: true\n  }\n}];"
      },
      "id": "42d6ffec-76d2-4f9f-a39c-608c33e8113e",
      "name": "Code: Build Enriched Item (Success)",
      "type": "n8n-nodes-base.code",
